# CareRoute (केयररूट) - Environment Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file or private keys to git!

# --- Fetch.ai Agent Deterministic Seeds (Generate via: python scripts/generate_seeds.py) ---
DISPATCHER_SEED="CHANGE_ME"
DIAGNOSTIC_SEED="CHANGE_ME"
LOGISTICS_SEED="CHANGE_ME"
ESCROW_SEED="CHANGE_ME"

# --- Agent Network & Host Ports ---
AGENT_HOST="127.0.0.1"
DISPATCHER_PORT=8000
DIAGNOSTIC_PORT=8001
LOGISTICS_PORT=8002
ESCROW_PORT=8003

# --- Agentverse / ASI:One Configuration ---
USE_AGENTVERSE=false
AGENT_ENDPOINT=""
AGENT_MAILBOX_KEY="CHANGE_ME"
AGENTVERSE_API_KEY="CHANGE_ME"
AGENTVERSE_URL="https://agentverse.ai"

# --- Reasoning Engine (ASI:One / OpenAI / Gemini) ---
# Primary: ASI:One official API (OpenAI-compatible)
ASI1_API_KEY="CHANGE_ME"
ASI1_BASE_URL="https://api.asi1.ai/v1"
ASI1_MODEL="asi1-mini"

# Optional Fallbacks
OPENAI_API_KEY="CHANGE_ME"
GEMINI_API_KEY="CHANGE_ME"
USE_MOCK_VLM=true

# --- Escrow & Payment Protocol ---
# PAYMENT_MODE: "simulation" | "testnet"
PAYMENT_MODE="simulation"
ESCROW_DEPOSIT_FET=0.5
ESCROW_TOKEN_DENOM="atestfet"
FETCH_TESTNET_RPC="https://rpc-dorado.fetch.ai:443"

# --- Clinic Authentication & Security ---
DEFAULT_CLINIC_ID="chc_alwar_01"
CLINIC_DESK_ADDRESSES="CHANGE_ME_COMMA_SEPARATED_FETCH_ADDRESSES"
CLINIC_DESK_TOKEN="CHANGE_ME_SHARED_DESK_TOKEN"

# --- UI & Interaction ---
USE_INTERACTIVE_CARDS=true
DATA_STORAGE_DIR="./data"
DATA_RETENTION_DAYS=30
